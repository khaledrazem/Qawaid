# Non-sensitive production defaults; loaded by Vite in production build. Sensitive vars must be set in Vercel (or .env.local for local).

# Supabase project URL (not secret — from Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://wupttezxwmywnxsmncti.supabase.co

# Public URL of the app — used as redirect target after Google login. Update to your Vercel URL after first deploy.
VITE_APP_URL=https://your-app.vercel.app

# Default difficulty distribution (weights; should sum to 1.0)
VITE_DIFFICULTY_DEFAULT_EASY_WEIGHT=0.5
VITE_DIFFICULTY_DEFAULT_MEDIUM_WEIGHT=0.3
VITE_DIFFICULTY_DEFAULT_HARD_WEIGHT=0.2

# Points per difficulty (base points per correct answer, before combo)
VITE_POINTS_EASY=10
VITE_POINTS_MEDIUM=20
VITE_POINTS_HARD=30

# Combo multiplier
VITE_COMBO_QUESTIONS_STEP=5
VITE_COMBO_MULTIPLIER_INCREMENT=0.05

# Difficulty adaptation (logged-in users)
VITE_DIFFICULTY_TARGET_MIN=20
VITE_DIFFICULTY_TARGET_MAX=50
VITE_DIFFICULTY_WEIGHT_DELTA=0.05

# Question batching
VITE_QUESTION_BATCH_SIZE=30
VITE_QUESTION_PRELOAD_THRESHOLD=5

# Offline cache
VITE_OFFLINE_CACHE_SIZE=100

# Leaderboard
VITE_LEADERBOARD_TOP_COUNT=3
VITE_LEADERBOARD_SURROUNDING_COUNT=4

# Admin auth domain (email = username@VITE_ADMIN_AUTH_DOMAIN)
VITE_ADMIN_AUTH_DOMAIN=admin.sahra.local
