# =============================================================================
# Qawaid — Environment Configuration
# =============================================================================
# Used by Vite (React); variables must be prefixed with VITE_ to be exposed
# to the client. Server-side or build-only vars can be unprefixed.
#
# Local development:
#   Copy this file to .env.local and add at least the SENSITIVE values
#   (VITE_SUPABASE_PUBLISHABLE_KEY). Optionally override VITE_SUPABASE_URL and
#   VITE_APP_URL. Do not commit .env.local.
#
# Production (Vercel):
#   Non-sensitive vars are in the repo (.env.production) and loaded by Vite
#   during "vite build". In Vercel, set ONLY the sensitive env vars (e.g.
#   VITE_SUPABASE_PUBLISHABLE_KEY). Use Secrets for sensitive values.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment mode
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase (required at build time)
# -----------------------------------------------------------------------------
# Project URL from Supabase dashboard → Settings → API (non-sensitive)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — set in .env.local locally and in Vercel as a Secret (sensitive)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role key — for future server-side use only. Never expose in client.
# Set only in Vercel (or .env.local) if you add serverless/API routes.
# SUPABASE_SECRET_KEY=

# Optional: direct DB connection (migrations / server-side only)
# DATABASE_URL=

# -----------------------------------------------------------------------------
# Backend API (Python FastAPI)
# -----------------------------------------------------------------------------
# Local dev: run backend with `python -m uvicorn main:app --reload --port 8000` and set:
# VITE_BACKEND_URL=http://localhost:8000
# VITE_BACKEND_URL=

# Backend reads these from root .env or backend/.env (Docker uses root .env):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# New signing keys (recommended): backend verifies via JWKS automatically from SUPABASE_URL.
# Optional overrides:
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# Legacy fallback only:
# SUPABASE_JWT_SECRET=your_legacy_hs256_secret
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SEED_SECRET=optional_for_post_api_seed_v1_1

# -----------------------------------------------------------------------------
# Google OAuth redirect
# -----------------------------------------------------------------------------
# Public URL of the app. Local: http://localhost:5173. Production: in .env.production
VITE_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Default difficulty distribution (guest and new users)
# -----------------------------------------------------------------------------
VITE_DIFFICULTY_DEFAULT_EASY_WEIGHT=0.5
VITE_DIFFICULTY_DEFAULT_MEDIUM_WEIGHT=0.3
VITE_DIFFICULTY_DEFAULT_HARD_WEIGHT=0.2

# -----------------------------------------------------------------------------
# Points per difficulty
# -----------------------------------------------------------------------------
VITE_POINTS_EASY=10
VITE_POINTS_MEDIUM=20
VITE_POINTS_HARD=30

# -----------------------------------------------------------------------------
# Combo multiplier
# -----------------------------------------------------------------------------
VITE_COMBO_QUESTIONS_STEP=5
VITE_COMBO_MULTIPLIER_INCREMENT=0.05

# -----------------------------------------------------------------------------
# Difficulty adaptation (logged-in users only)
# -----------------------------------------------------------------------------
VITE_DIFFICULTY_TARGET_MIN=20
VITE_DIFFICULTY_TARGET_MAX=50
VITE_DIFFICULTY_WEIGHT_DELTA=0.05

# -----------------------------------------------------------------------------
# Question batching
# -----------------------------------------------------------------------------
VITE_QUESTION_BATCH_SIZE=30
VITE_QUESTION_PRELOAD_THRESHOLD=5

# -----------------------------------------------------------------------------
# Leaderboard
# -----------------------------------------------------------------------------
VITE_LEADERBOARD_TOP_COUNT=3
VITE_LEADERBOARD_SURROUNDING_COUNT=4

# -----------------------------------------------------------------------------
# Offline cache
# -----------------------------------------------------------------------------
VITE_OFFLINE_CACHE_SIZE=100

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Auth email for admin = username@VITE_ADMIN_AUTH_DOMAIN
VITE_ADMIN_AUTH_DOMAIN=admin.sahra.local

# For future server-side admin session signing. Set only in Vercel or .env.local.
# ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# AWS S3 (optional — not used in MVP)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# VITE_S3_BUCKET=
# VITE_S3_PUBLIC_URL=
