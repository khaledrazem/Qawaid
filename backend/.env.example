# =============================================================================
# Backend (Python) — copy to .env and fill values, or set these in project root .env
# =============================================================================
# config.py loads: backend/.env first, then project root .env
# Docker Compose uses project root .env (env_file: .env)
# =============================================================================

# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT verification (new Supabase signing keys via JWKS; recommended)
# Usually no need to set SUPABASE_JWKS_URL because it is derived from SUPABASE_URL.
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Optional stricter checks:
# SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# Legacy fallback (HS256 only; older projects)
# SUPABASE_JWT_SECRET=your_legacy_jwt_secret

# Optional — comma-separated. Local Vite + default production (qawaid-iota.vercel.app) are merged in unless CORS_STRICT=1.
# CORS_ORIGINS=https://extra-domain.example
# CORS_STRICT=1
SEED_SECRET=optional_for_post_api_seed_v1_1
